# Senthuron Ops — Environment Variables
# Copy this file to .env.local for local development and fill in real values.
# Never commit .env or .env.local.

# Neon PostgreSQL — POOLED connection string (used at runtime by the app)
# Host must contain "-pooler". Append ?sslmode=require&uselibpqcompat=true
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DBNAME?sslmode=require&uselibpqcompat=true"

# Neon PostgreSQL — DIRECT connection string (used only by Prisma CLI for migrations/seed)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require&uselibpqcompat=true"

# Business timezone — used for "today" calculations. Defaults to Asia/Kolkata.
# APP_TIMEZONE="Asia/Kolkata"

# Authentication
# BETTER_AUTH_SECRET="generate-a-strong-32-char-random-string"
# BETTER_AUTH_URL="https://your-production-domain.com"

# Google OAuth (Optional, for "Continue with Google")
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"
