# Senthuron Ops — Environment Variables
# Copy this file to .env.local for local development and fill in real values.
# Never commit .env or .env.local.

# Neon PostgreSQL — POOLED connection string (used at runtime by the app)
# Host must contain "-pooler". Append ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DBNAME?sslmode=require"

# Neon PostgreSQL — DIRECT connection string (used only by Prisma CLI for migrations/seed)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Business timezone — used for "today" calculations. Defaults to Asia/Kolkata.
# APP_TIMEZONE="Asia/Kolkata"

# Optional passphrase gate (basic-auth). Both must be set to enable.
# ACCESS_PASSPHRASE_USER="admin"
# ACCESS_PASSPHRASE_PASSWORD="change-me-to-a-long-random-string"
